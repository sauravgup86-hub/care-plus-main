PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Exact browser origins, comma-separated, with no trailing slashes.
CLIENT_URLS=https://your-frontend-domain.vercel.app,https://your-admin-domain.vercel.app

CLOUDINARY_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_SECRET_KEY=your-cloudinary-api-secret

# Stripe is initialized when the API starts; use a test key until launch.
STRIPE_SECRET_KEY=sk_test_replace_me
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-secret
CURRENCY=INR

# SMTP settings are used by the contact form; EMAIL_* are used for notifications.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_SECURE=false
EMAIL_USER=notifications@example.com
EMAIL_PASS=your-email-app-password
